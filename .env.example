# ==================== 飞书开放平台配置 ====================
# 飞书应用 App ID（从飞书开放平台 -> 应用凭证 获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxx

# 飞书应用 App Secret
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格 App Token（多维表格URL中 /base/ 后的字符串）
FEISHU_BITABLE_APP_TOKEN=BASxxxxxxxxxxxxxxxxxx

# 飞书多维表格 数据表 ID（进入多维表格后URL中 /table/ 后的字符串）
FEISHU_BITABLE_TABLE_ID=tblxxxxxxxxxxxx

# ==================== DeepSeek AI 配置 ====================
# DeepSeek API Key（用于图片多模态识别）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API Base URL（默认官方地址，可自定义代理）
DEEPSEEK_API_BASE=https://api.deepseek.com

# ==================== 火山引擎 ASR 配置 ====================
# 火山引擎语音识别应用 ID
VOLCANO_ASR_APP_ID=xxxxxxxxxxxx

# 火山引擎语音识别 Access Token
VOLCANO_ASR_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== NAS 访问配置 ====================
# NAS 外网访问域名（用于 PWA 部署和 HTTPS）
DOMAIN=https://your-domain.com

# Flask 密钥（生产环境请随机生成）
FLASK_SECRET_KEY=change-me-to-a-random-string-in-production
