# ==================== 个人3D打印物料库存系统 v3 ====================
# 数据存储: 本地 SQLite
# AI引擎: DeepSeek / 通义千问 / 火山引擎
# 复制此文件为 .env 并填入真实值

# ---------- Flask 安全密钥（必填，生产环境请随机生成）----------
# 生成密钥: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-random-secret-key-here

# ---------- AI API 配置（至少配置一个）----------

# DeepSeek（支持图片识别）
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_API_BASE=https://api.deepseek.com

# 通义千问（支持图片识别 + 音频理解）
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 火山引擎
# VOLCANO_API_KEY=your-volcano-api-key

# ---------- 火山引擎 ASR 语音识别（可选）----------
# VOLCANO_ASR_APP_ID=xxxxxxxxxxxx
# VOLCANO_ASR_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VOLCANO_ASR_CLUSTER=volcengine_input_common

# ---------- NAS/部署配置 ----------
# NAS 外网访问域名（PWA 部署用）
# DOMAIN=https://your-domain.com
